{
  "name": "utm-desk-nosql-cloud",
  "version": "1.0.0",
  "private": true,
  "description": "UTM Desk NoSQL Cloud - Monorepo Fullstack (React Vite + Express Serverless + MongoDB Atlas + Supabase Storage)",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "node backend/src/server.js",
    "seed": "node backend/src/seed/seedData.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
