# ==============================================================
# UTM DESK NOSQL CLOUD - VARIABLES DE ENTORNO (PLANTILLA)
# ==============================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a '.env' dentro de la carpeta 'backend/'.
# 2. Reemplaza los valores con tus credenciales de MongoDB Atlas y Supabase.
# 3. NUNCA subas tu archivo '.env' a GitHub o repositorios públicos.
# ==============================================================

# Puerto de la API REST
PORT=5000

# Cadena de Conexión a MongoDB Atlas (Cluster NoSQL)
# Ejemplo: mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/utm_desk_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://tu_usuario:tu_password@cluster0.mongodb.net/utm_desk_db?retryWrites=true&w=majority

# Credenciales de Supabase Storage (Proyecto Supabase)
# Project URL obtenida en Settings -> API -> Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key (o Anon Key con permisos de Storage)
# NOTA: Usar 'service_role' para operaciones seguras en backend hacia buckets privados
SUPABASE_SERVICE_KEY=tu_supabase_service_role_key_aqui

# Nombre del Bucket Privado en Supabase Storage
SUPABASE_BUCKET=evidencias-campus
